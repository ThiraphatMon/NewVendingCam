# ═══════════════════════════════════════════════════════════════════
# VendingCam — ไฟล์ตั้งค่า
# วิธีใช้:  cp .envexample .env  แล้วแก้ค่าในหมวด 1 ให้ตรงกับตู้
# ค่าที่ไม่ได้ใส่จะใช้ default (ดูคำอธิบายเต็มใน config.py)
# ═══════════════════════════════════════════════════════════════════

# ── หมวด 1: ตัวตนตู้และการเชื่อมต่อ (ต้องตั้งทุกตู้) ──────────────────
MACHINE_ID_DEFAULT=VENDING_01
CLOUD_API_URL=http://your-server:5100/api/events
WS_URL=ws://your-server:5100/ws
API_KEY=
CAMERA_INDEX=0
HEADLESS=1

# ── หมวด 2: ความไว / ความเร็วการจับ (จูนบ่อย) ───────────────────────
CAPTURE_HOLD_SEC=0.5
MOT_THRESH=25
MIN_AREA=150
MAX_BLOB_ROI_RATIO=0.30
# LANDING_STABLE_FRAMES=4
# CENTROID_STABLE_DIST=10

# ── หมวด 3: เวลา order / reset ─────────────────────────────────────
ORDER_WINDOW=30
# CONFIRMED_HOLD_TIMEOUT=20
# DROP_TIMEOUT=25
# CAP_COUNT_TO_ORDER_QTY=1

# ── หมวด 4: ขั้นสูง (ปกติไม่ต้องแก้) ──────────────────────────────────
# GROUP_MODE=distance
# GROUP_DIST=60
# GROUP_OVERLAP_PAD=4
# MORPH_OPEN_KSIZE=5
# MORPH_DILATE_KSIZE=5
# MORPH_DILATE_ITER=2
# TRACK_MATCH_DIST=150
# GHOST_FRAME_TOLERANCE=2
# BG_LEARNING_RATE=0.1
# RESET_GRACE_SEC=1.5
# BG_RELEARN_RATE=0.3
# CLEAN_BG_INTERVAL=0.5
# ENV_CHANGE_REBASELINE=1

# ── หมวด 5: ระบบ / ดูแลเครื่อง ─────────────────────────────────────
# SEND_INTERVAL=1
# ROI_POLL_INTERVAL=10
# ROI_CHECK_INTERVAL=5
# RETRY_INTERVAL=60
# CAMERA_RECONNECT_SEC=2
# WS_RECONNECT_SEC=5
CLEANUP_KEEP_DAYS=3
CLEANUP_INTERVAL_HOURS=1
